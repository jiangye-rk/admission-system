<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.admission.mapper.AdmissionDataMapper">

    <!-- 分页查询院校列表（支持搜索） -->
    <select id="selectSchoolListPage" resultType="java.util.HashMap">
        SELECT DISTINCT yxdm, yxmc
        FROM admission_data
        WHERE nf = #{year}
        <if test="keyword != null and keyword != ''">
            AND yxmc LIKE CONCAT('%', #{keyword}, '%')
        </if>
        ORDER BY yxdm
    </select>

    <!-- 分页查询专业列表（支持搜索） -->
    <select id="selectMajorListPage" resultType="java.util.HashMap">
        SELECT DISTINCT zydm, zymc
        FROM admission_data
        WHERE nf = #{year}
        <if test="yxdm != null and yxdm != ''">
            AND yxdm = #{yxdm}
        </if>
        <if test="keyword != null and keyword != ''">
            AND zymc LIKE CONCAT('%', #{keyword}, '%')
        </if>
        ORDER BY zydm
    </select>

</mapper>
